;; nbb reads this file and does NOT read deps.edn. The .cljs scripts here are
;; run as bare `nbb scripts/<name>.cljs` with no --classpath, so a coordinate
;; that lives only in deps.edn is invisible to them.
;;
;; Measured 2026-09-09: `kbb --backend sci scripts/verify_primary_sources.cljk` answered
;; "Could not find namespace: kotoba.lang.edn" BEFORE this migration touched
;; the repo -- so these scripts were already unrunnable, and the migration to
;; kotoba.lang.text would have added a second namespace to the same hole.
;; Both coordinates are copied from deps.edn rather than chosen here.
;;
;; With both declared the script now LOADS and runs to scripts/
;; verify_primary_sources.cljs:168, where kotoba.lang.edn refuses the
;; registry's own EDN with "EDN dispatch forms are forbidden". That is a
;; third, separate blocker, older than this file and not addressed by it --
;; written down so the next reader does not take a running `nbb` as proof
;; that this repo's .cljs verification passes. It does not run yet.
{:paths ["src"]
 :deps {
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        io.github.kotoba-lang/text {:git/sha "2ee6dce2ca944decd001f9378868dd703fc3e741"}
        io.github.kotoba-lang/edn {:git/url "https://github.com/kotoba-lang/edn.git"
                                   :git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}}}
