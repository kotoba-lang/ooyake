{:paths ["src"]
 ;; ooyake の実行系は長く bb.edn だけだった。ADR-2607173000 が bb を退役させている
 ;; ので、新しい実行経路は clojure alias で足す（bb.edn には手を触れない）。
 :deps {
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "2ee6dce2ca944decd001f9378868dd703fc3e741"}
       org.clojure/clojure {:mvn/version "1.12.0"}
         io.github.kotoba-lang/edn
         {:git/url "https://github.com/kotoba-lang/edn.git"
          :git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}}
 :aliases
 {;; registry を datalog で引く。DataScript であって Datomic でないのは、registry が
  ;; transactor を持たないファイル群だから — スキーマはどちらにもそのまま transact できる。
  ;; nbb + npm datascript を使わない理由は kawaraban の query.clj と同じで、
  ;; datascript.js だと属性も値も裸文字列に潰れ :db.unique/identity も keyword 値も消える。
  :query {:extra-deps {datascript/datascript {:mvn/version "1.7.4"}}
          :main-opts ["-m" "ooyake.query"]}}}