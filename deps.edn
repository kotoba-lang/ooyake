{:paths ["src"]
 ;; ooyake の実行系は長く bb.edn だけだった。ADR-2607173000 が bb を退役させている
 ;; ので、新しい実行経路は clojure alias で足す（bb.edn には手を触れない）。
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.0"}
         io.github.kotoba-lang/edn
         {:git/url "https://github.com/kotoba-lang/edn.git"
          :git/sha "250f4dafa5f5c7fb3109703496a52866e2a62dcd"}}
 :aliases
 {;; registry を datalog で引く。DataScript であって Datomic でないのは、registry が
  ;; transactor を持たないファイル群だから — スキーマはどちらにもそのまま transact できる。
  ;; nbb + npm datascript を使わない理由は kawaraban の query.clj と同じで、
  ;; datascript.js だと属性も値も裸文字列に潰れ :db.unique/identity も keyword 値も消える。
  :query {:extra-deps {datascript/datascript {:mvn/version "1.7.4"}}
          :main-opts ["-m" "ooyake.query"]}}}